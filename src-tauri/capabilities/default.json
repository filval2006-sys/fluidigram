{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:allow-read-text-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/filval2006-sys/fluidigram/**" }]
    }
  ]
}