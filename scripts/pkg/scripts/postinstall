#!/bin/sh
# Removes the "downloaded from the internet" mark from the freshly installed app, so a second warning does not appear on opening.
for app in /Applications/Fluidigram.app "$HOME/Applications/Fluidigram.app" "$2/Fluidigram.app"; do
  [ -d "$app" ] && xattr -cr "$app" 2>/dev/null
done
exit 0
